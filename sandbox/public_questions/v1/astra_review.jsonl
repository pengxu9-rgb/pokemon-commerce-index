{"id": "pubq-010", "label": {"actor": "buyer", "forbidden_claims": ["authenticity", "condition", "exact_card", "price"], "identity_state": "needs_photo", "next_action": "ask_photos", "primary_intent": "price_comparison", "required_evidence": ["card_metadata", "listing_photos", "verified_sales"]}, "model_family": "astra", "question_sha256": "b336cd693812f8a67b5cdc6440c40803fbc56bcf8e2a84c2bb8ba01a5ab2fef1", "rationale": "A price and marketplace context suggest purchase evaluation, but what do you think is ambiguous. The only referenced photo is unavailable and cannot support identity, condition, authenticity or value conclusions.", "status": "ok"}
